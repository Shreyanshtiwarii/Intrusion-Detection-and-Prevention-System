# CyberShield IDS/IPS - Environment Configuration
# Copy/rename this file's values as needed. Do not commit real secrets to source control.

# --- Core Flask ---
SECRET_KEY=cybershield-dev-secret-change-in-production
FLASK_ENV=development
FLASK_DEBUG=False

# --- Default Admin Credentials (seeded on first run only) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- Server ---
HOST=0.0.0.0
PORT=5000

# --- Packet Capture ---
# Leave CAPTURE_INTERFACE blank to auto-select the default interface.
CAPTURE_INTERFACE=
CAPTURE_BPF_FILTER=
AUTO_START_CAPTURE=true
MAX_PACKET_LOG_RETENTION=50000

# --- IDS Detection Thresholds ---
SYN_FLOOD_THRESHOLD=100
UDP_FLOOD_THRESHOLD=150
ICMP_FLOOD_THRESHOLD=100
PORT_SCAN_THRESHOLD=15
BRUTE_FORCE_THRESHOLD=5
EXCESSIVE_REQUEST_THRESHOLD=200
DETECTION_WINDOW_SECONDS=10

# --- IPS ---
AUTO_BLOCK_ENABLED_DEFAULT=True
DEFAULT_BLOCK_DURATION_MINUTES=60
WHITELIST_IPS=127.0.0.1

# --- File Integrity Monitoring ---
FIM_SCAN_INTERVAL_SECONDS=30

# --- Session ---
SESSION_HOURS=8

# --- Logging ---
LOG_LEVEL=INFO

# --- SocketIO ---
SOCKETIO_ASYNC_MODE=threading
